# OIHK Basic — backend environment variables (all optional)
#
# OIHK Basic runs fully local-first without any cloud dependency. The values
# below are the safe defaults; nothing here is required for the desktop build.
#
# IMPORTANT: never commit a real .env file. Secrets are auto-generated on first
# run under the operating system's configuration directory (see first_run.py).

# --- Application ---
# OIHK_APP_NAME=OIHK Basic
# OIHK_ENVIRONMENT=development
# SQLite URL. Leave empty to use the per-user default under %APPDATA%/OIHK-Basic
# (Windows), ~/Library/Application Support/OIHK-Basic (macOS) or
# $XDG_DATA_HOME/OIHK-Basic (Linux).
# OIHK_DATABASE_URL=sqlite+aiosqlite:///C:/Users/<you>/AppData/Roaming/OIHK-Basic/oihk-basic.db
# Storage directory for managed evidence. Leave empty for the per-user default.
# OIHK_STORAGE_DIR=
# Allowed CORS origins (comma separated) for the local web UI.
# OIHK_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# OIHK_API_LOG_LEVEL=INFO

# --- Authentication (OPTIONAL, desktop edition is single-user) ---
# Enable only for custom multi-user deployments. When disabled the backend is
# forced to bind to loopback only.
# OIHK_AUTH_ENABLED=false
# OIHK_JWT_SECRET=
# OIHK_CUSTODY_SIGNING_KEY=
# OIHK_CUSTODY_KEY_ID=
# OIHK_ACCESS_TOKEN_TTL_MINUTES=720
# OIHK_BOOTSTRAP_ADMIN_EMAIL=
# OIHK_BOOTSTRAP_ADMIN_PASSWORD=
# OIHK_PUBLIC_REGISTRATION=false
# OIHK_AUTO_CREATE_TABLES=true

# --- Local models (LM Studio / Ollama / OpenAI-compatible) ---
# The default endpoints used by "Detect services".
# OIHK_LM_STUDIO_ENDPOINT=http://127.0.0.1:1234
# OIHK_OLLAMA_ENDPOINT=http://127.0.0.1:11434

# --- AI (legacy global settings; the desktop UI configures models per user) ---
# OIHK_AI_API_KEY=
# OIHK_AI_BASE_URL=
# OIHK_AI_MODEL=
# OIHK_AI_LOCAL=false
# OIHK_AI_TEMPERATURE=0.2
# OIHK_AI_MAX_TOKENS=2048

# --- Public OSINT / web search (user-provided, no defaults) ---
# OIHK_SEARXNG_URL=
# OIHK_SEARXNG_PUBLIC_FALLBACK=false
# OIHK_BRAVE_API_KEY=
# OIHK_SEARCH_MAX_QUERIES=4
# OIHK_SEARCH_MAX_RESULTS_PER_QUERY=5
# OIHK_SEARCH_TARGET_RESULTS=50
# OIHK_MAX_FETCH_BYTES=1048576
# OIHK_MAX_EVIDENCE_BYTES=262144000
# OIHK_SEARCH_DEEP_READ=true
# OIHK_SEARCH_MAX_PAGES=10
# OIHK_SEARCH_LINK_DEPTH=1
# OIHK_SEARCH_LINKS_PER_PAGE=2

# --- Rate limiting ---
# OIHK_RATE_LIMIT_ENABLED=true
# OIHK_RATE_LIMIT_PER_MINUTE=120
# OIHK_RATE_LIMIT_TRUST_FORWARDED=false
