# OIHK Basic — Configuration
# All variables are optional. Defaults work for local-first usage.
# On first run, JWT and custody secrets are auto-generated.
# Copy this file to .env only if you need custom overrides.

# Application
OIHK_APP_NAME=OIHK Basic
OIHK_ENVIRONMENT=development

# Database (default: ~/.local/share/OIHK-Basic/oihk-basic.db)
# OIHK_DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/your.db

# Storage (default: ~/.local/share/OIHK-Basic/storage/)
# OIHK_STORAGE_DIR=/absolute/path/to/storage

# CORS (for development with separate frontend)
# OIHK_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Authentication (disabled by default for the loopback-only desktop edition)
# Enable this only for a custom deployment with an administrator account.
# OIHK_AUTH_ENABLED=false
# OIHK_PUBLIC_REGISTRATION=false
# OIHK_ACCESS_TOKEN_TTL_MINUTES=720

# Bootstrap Admin (for automated first-time setup)
# OIHK_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# OIHK_BOOTSTRAP_ADMIN_PASSWORD=your-secure-password

# Rate Limiting
# OIHK_RATE_LIMIT_ENABLED=true
# OIHK_RATE_LIMIT_PER_MINUTE=120

# Web Search (optional, user-provided)
# OIHK_BRAVE_API_KEY=your-brave-api-key
# OIHK_SEARXNG_URL=https://your-searxng-instance.com

# AI (optional, user-provided)
# OIHK_AI_API_KEY=your-ai-api-key
# OIHK_AI_BASE_URL=https://your-ai-endpoint.com
# OIHK_AI_MODEL=your-model-name
