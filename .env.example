# =============================================================================
# OIHK Basic — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All settings are OPTIONAL. OIHK Basic works out-of-the-box with defaults.

# --- Application ---
OIHK_APP_NAME=OIHK Basic
OIHK_ENVIRONMENT=development
# Default: SQLite in OS data directory (%APPDATA%/OIHK-Basic, ~/.local/share/OIHK-Basic, etc.)
# Uncomment to override:
# OIHK_DATABASE_URL=sqlite+aiosqlite:///./oihk-basic.db
OIHK_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Default: OS data directory /storage
# Uncomment to override:
# OIHK_STORAGE_DIR=./storage
OIHK_API_LOG_LEVEL=INFO

# --- Authentication ---
# Set a strong secret in production (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
OIHK_JWT_SECRET=change-me-in-production-oihk-basic-secret
OIHK_CUSTODY_SIGNING_KEY=change-me-in-production-oihk-basic-custody-secret
OIHK_CUSTODY_KEY_ID=oihk-basic-dev
OIHK_AUTH_ENABLED=true
OIHK_ACCESS_TOKEN_TTL_MINUTES=720

# Bootstrap admin (uncomment and set both for first-run admin account)
# OIHK_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# OIHK_BOOTSTRAP_ADMIN_PASSWORD=your-secure-password

# Enable public registration (development only)
# OIHK_PUBLIC_REGISTRATION=true

# --- AI (optional, local only) ---
# For local models via Ollama/LM Studio
# OIHK_AI_BASE_URL=http://localhost:11434/v1
# OIHK_AI_MODEL=llama3
# OIHK_AI_LOCAL=true

# For cloud AI providers (optional)
# OIHK_AI_API_KEY=your-api-key
# OIHK_AI_BASE_URL=https://api.openai.com/v1
# OIHK_AI_MODEL=gpt-4o-mini

# --- Web Search (optional, user-provided) ---
# Self-hosted SearXNG instance (recommended)
# OIHK_SEARXNG_URL=http://localhost:8888

# Brave Search API (free tier available)
# OIHK_BRAVE_API_KEY=your-brave-api-key

# --- Rate Limiting ---
OIHK_RATE_LIMIT_ENABLED=true
OIHK_RATE_LIMIT_PER_MINUTE=120
