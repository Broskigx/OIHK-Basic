{
  "name": "oihk-basic-frontend",
  "version": "0.2.0-beta.1",
  "private": true,
  "license": "MIT",
  "author": "OIHK Basic",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "tsc -b --noEmit && eslint .",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri:build": "tauri build --config ../src-tauri/tauri.local.conf.json",
    "release:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-windows.ps1 -Release -Channel local -Unsigned -SkipUpdater",
    "release:alpha": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-windows.ps1 -Release -Channel alpha"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "animejs": "^4.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.65.0",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  }
}
